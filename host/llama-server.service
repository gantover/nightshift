# systemd user unit: the local model on :8080 for OpenCode (installed by host/install-llama.sh).
#   journalctl --user -u llama-server -f
# First start downloads ~94 GB into ~/.cache/llama.cpp. --alias is the model id in
# opencode/opencode.json; -c must be >= its "limit.context". -np 1: the night runs one agent.
# -fit off: fail loudly instead of silently moving experts to the CPU. --load-mode none:
# no mmap, so the file isn't also held in page cache. -c 262144 is the model's full context;
# llama.cpp allocates it all at startup (~7.5 GiB), and --cache-ram 0 stops the prompt cache
# growing up to 8 GiB more later, so memory never grows after load. UD-IQ4_XS leaves ~20 GiB
# of the 128 GB for the desktop and the sbx sandbox.
[Unit]
Description=llama-server (Qwen3.8-Flash-Next, UD-IQ4_XS)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/llama-server -hf unsloth/Qwen3.8-Flash-Next-GGUF:UD-IQ4_XS --alias qwen3.8-flash-next --jinja -ngl 999 -fa on -c 262144 -np 1 -fit off --load-mode none --cache-ram 0 --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
